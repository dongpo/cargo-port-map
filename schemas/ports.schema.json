{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ports",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": [
          "string",
          "null"
        ]
      },
      "flag": {
        "type": [
          "string",
          "null"
        ]
      },
      "longitude": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "latitude": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "anchorage_id": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "name",
      "flag",
      "longitude",
      "latitude",
      "anchorage_id"
    ],
    "additionalProperties": false
  }
}
